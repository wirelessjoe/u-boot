# Configuration for building U-Boot for Google Pixel 4 (google-flame)
CONFIG_DEFAULT_DEVICE_TREE="qcom/sm8150-google-flame"
CONFIG_DEFAULT_ENV_FILE="board/qualcomm/qcom-phone.env"

# Required to bypass bootloader limitations
CONFIG_TEXT_BASE=0x80080000

# Hang on panic so the error message can be read
CONFIG_PANIC_HANG=y

# We use pause in various places to allow text to be read
# before it scrolls off the screen
CONFIG_CMD_PAUSE=y
CONFIG_BOOT_RETRY=y
CONFIG_BOOT_RETRY_TIME=1
CONFIG_BUTTON_REMAP_PHONE_KEYS=y
CONFIG_RETRY_BOOTCMD=y

# Various settings
CONFIG_USB_FUNCTION_FASTBOOT=y
CONFIG_USB_FUNCTION_ACM=y
CONFIG_USB_HOST_ETHER=y
CONFIG_USB_KEYBOARD=y
CONFIG_CMD_UMS_ABORT_KEYED=n
CONFIG_CMD_UFETCH=y
CONFIG_CMD_USB_MASS_STORAGE=y
CONFIG_CMD_EXT4=y  
CONFIG_DM_REGULATOR_QCOM_USB_VBUS=y
CONFIG_SYMBOL_LOOKUP=y

# Record all console output and let it be dumped via fastboot
CONFIG_CONSOLE_RECORD=y
CONFIG_CONSOLE_RECORD_INIT_F=y
CONFIG_CONSOLE_RECORD_OUT_SIZE=0x6000
CONFIG_FASTBOOT_CMD_OEM_CONSOLE=y

# Fastboot configuration
CONFIG_FASTBOOT_FLASH=y
CONFIG_FASTBOOT_FLASH_MMC_DEV=0
CONFIG_FASTBOOT_OEM_RUN=y
CONFIG_FASTBOOT_OEM_BOARD=y

# Add EFI support
CONFIG_EFI_CAPSULE_FIRMWARE_RAW=y
CONFIG_EFI_CAPSULE_ON_DISK=y
CONFIG_EFI_HTTP_BOOT=y
CONFIG_EFI_IGNORE_OSINDICATIONS=y
CONFIG_EFI_RT_VOLATILE_STORE=y
CONFIG_EFI_RUNTIME_UPDATE_CAPSULE=y
CONFIG_EFI_SET_TIME=y
