# SPDX-License-Identifier: GPL-2.0+
bootdelay=0
bootretry=1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
fastboot=fastboot -l $fastboot_addr_r usb 0
preboot=sleep 2; scsi scan
native_boot=if part number scsi 0 userdata rootpart; then if ext4load scsi 0:${rootpart} ${fastboot_addr_r} /boot/omamobile/boot.img; then bootm ${fastboot_addr_r}; fi; fi
bootcmd=run native_boot; run fastboot
serial_gadget=setenv stdin serial,button-kbd,usbacm; setenv stdout serial,vidconsole,usbacm; setenv stderr serial,vidconsole,usbacm; setenv bootretry -1
menucmd=setenv bootcmd run menucmd; bootmenu -1
bootmenu_0=Start Omarchy=run native_boot
bootmenu_1=Enable attached USB serial console=run serial_gadget
bootmenu_2=Fastboot download mode=run fastboot
bootmenu_3=Reset device=reset
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
